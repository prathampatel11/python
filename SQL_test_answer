## Section 4: Aggregate Functions, GROUP BY, HAVING## 36. Count total number of films in the database

SELECT COUNT(*) AS total_films FROM film;

## 37. Find the average rental_rate of all films

SELECT AVG(rental_rate) AS average_rental_rate FROM film;

## 38. Show the number of films per category, sorted descending

SELECT category.name, COUNT(film_category.film_id) AS total_films FROM category, film_category WHERE category.category_id = film_category.category_id GROUP BY category.name ORDER BY total_films DESC;

## 39. Find the total payment collected by each staff member

SELECT staff_id, SUM(amount) AS total_collected FROM payment GROUP BY staff_id;

## 40. Show customers who have made more than 10 rentals

SELECT customer_id, COUNT(*) AS rental_count FROM rental GROUP BY customer_id HAVING rental_count > 10;

## 41. Find categories where average film length is greater than 120 minutes

SELECT category.name, AVG(film.length) AS avg_length FROM category, film_category, film WHERE category.category_id = film_category.category_id 
  AND film_category.film_id = film.film_id GROUP BY category.name HAVING avg_length > 120;

## 42. Calculate total revenue per month from payments

SELECT DATE_FORMAT(payment_date, '%Y-%m') AS payment_month, SUM(amount) AS monthly_revenue FROM payment GROUP BY payment_month;

## 43. Find actors who have appeared in more than 20 films

SELECT actor_id, COUNT(*) AS film_count FROM film_actor GROUP BY actor_id HAVING film_count > 20;

## 44. Show stores with the highest number of rentals

SELECT store_id, COUNT(rental.rental_id) AS total_rentals FROM inventory, rental WHERE inventory.inventory_id = rental.inventory_id GROUP BY store_id ORDER BY total_rentals DESC;

## 45. Find the most rented film

SELECT film.title, COUNT(rental.rental_id) AS times_rented FROM film, inventory, rental WHERE film.film_id = inventory.film_id 
  AND inventory.inventory_id = rental.inventory_id GROUP BY film.title ORDER BY times_rented DESC LIMIT 1;

