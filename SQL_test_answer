UPDATE film, film_category, category SET film.rental_rate = 3.99 WHERE film.film_id = film_category.film_id 
  AND film_category.category_id = category.category_id 
  AND category.name = 'Action';

## 8. Increase the replacement_cost of all films longer than 120 minutes by 10%

UPDATE film SET replacement_cost = replacement_cost * 1.10 WHERE length > 120;

## 9. Update the email of customer with customer_id=5

UPDATE customer SET email = 'newemail@example.com' WHERE customer_id = 5;

## 10. Set all inactive customers to active

UPDATE customer SET active = 1 WHERE active = 0;

