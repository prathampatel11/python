## Section 2: Basic SELECT & Filtering## 16. List all actors sorted by last_name ascending

SELECT * FROM actor ORDER BY last_name ASC;

## 17. Show all films released in 2006 with rental_rate > 4.00

SELECT * FROM film WHERE release_year = 2006 AND rental_rate > 4.00;

## 18. Find customers whose last_name starts with 'S'

SELECT * FROM customer WHERE last_name LIKE 'S%';

## 19. Display the top 10 most expensive films

SELECT * FROM film ORDER BY replacement_cost DESC LIMIT 10;

## 20. Show all stores and their manager staff names (No JOIN)

SELECT store.store_id, staff.first_name, staff.last_name FROM store, staff WHERE store.manager_staff_id = staff.staff_id;

## 21. List all languages available

SELECT name FROM language;

## 22. Find films that have 'love' in their description

SELECT * FROM film WHERE description LIKE '%love%';

## 23. Display customers who are not active

SELECT * FROM customer WHERE active = 0;

## 24. Show rental records where return_date is NULL

SELECT * FROM rental WHERE return_date IS NULL;

## 25. List all cities in India or any country starting with 'I' (No JOIN)

SELECT city.city FROM city, country WHERE city.country_id = country.country_id 
  AND country.country LIKE 'I%';

